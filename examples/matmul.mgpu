kernel matmul(float* A, float* B, float* C, int N) {
    int row = thread_id_y();
    int col = thread_id_x();

    if (row < N && col < N) {
        float sum = 0.0;
        for (int k = 0; k < N; k++) {
            sum += A[row * N + k] * B[k * N + col];
        }
        C[row * N + col] = sum;
    }
}
